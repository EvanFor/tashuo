generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum TopicStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum IdentityMode {
  PUBLIC
  ANONYMOUS
}

enum ContentVisibility {
  PUBLIC
  HIDDEN
  DELETED
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

enum ModerationActionType {
  WARNING
  HIDE_CONTENT
  DELETE_CONTENT
  RATE_LIMIT
  MUTE
  TEMPORARY_BAN
  PERMANENT_BAN
  RESTORE_ACCESS
}

enum AppealStatus {
  OPEN
  REVIEWING
  UPHELD
  REVERSED
  MODIFIED
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  status          UserStatus  @default(ACTIVE)
  profile         UserProfile?
  posts           Post[]
  comments        Comment[]
  reports         Report[]    @relation("ReportAuthor")
  appeals         Appeal[]    @relation("AppealAuthor")
  sessions        UserSession[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status, createdAt])
}

model UserProfile {
  userId    String   @id
  nickname  String   @unique
  avatarKey String?
  bio       String   @default("") @db.VarChar(240)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
}

model Topic {
  id               String      @id @default(cuid())
  slug             String      @unique
  title            String
  description      String      @default("") @db.VarChar(500)
  anonymousEnabled Boolean     @default(false)
  status           TopicStatus @default(DRAFT)
  posts            Post[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status, createdAt])
}

model Post {
  id           String            @id @default(cuid())
  authorId     String
  topicId      String
  title        String?           @db.VarChar(180)
  body         String            @db.Text
  identityMode IdentityMode      @default(PUBLIC)
  visibility   ContentVisibility @default(PUBLIC)
  author       User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  topic        Topic             @relation(fields: [topicId], references: [id], onDelete: Restrict)
  comments     Comment[]
  reports      Report[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  @@index([topicId, visibility, createdAt])
  @@index([authorId, createdAt])
}

model Comment {
  id           String            @id @default(cuid())
  postId       String
  authorId     String
  parentId     String?
  body         String            @db.Text
  identityMode IdentityMode      @default(PUBLIC)
  visibility   ContentVisibility @default(PUBLIC)
  post         Post              @relation(fields: [postId], references: [id], onDelete: Restrict)
  author       User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parent       Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Restrict)
  replies      Comment[]         @relation("CommentReplies")
  reports      Report[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  @@index([postId, visibility, createdAt])
  @@index([authorId, createdAt])
  @@index([parentId, createdAt])
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  postId     String?
  commentId  String?
  reasonCode String
  details    String?      @db.VarChar(1000)
  status     ReportStatus @default(OPEN)
  reporter   User         @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Restrict)
  post       Post?        @relation(fields: [postId], references: [id], onDelete: Restrict)
  comment    Comment?     @relation(fields: [commentId], references: [id], onDelete: Restrict)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
}

model ModerationAction {
  id            String               @id @default(cuid())
  subjectUserId String
  actorUserId   String
  actionType    ModerationActionType
  reasonCode    String
  explanation   String               @db.VarChar(2000)
  startsAt      DateTime             @default(now())
  endsAt        DateTime?
  reversedAt    DateTime?
  appeals       Appeal[]
  createdAt     DateTime             @default(now())

  @@index([subjectUserId, createdAt])
  @@index([actorUserId, createdAt])
}

model Appeal {
  id          String       @id @default(cuid())
  actionId    String
  appellantId String
  statement   String       @db.VarChar(3000)
  status      AppealStatus @default(OPEN)
  reviewerId  String?
  decision    String?      @db.VarChar(3000)
  decisionAt  DateTime?
  action      ModerationAction @relation(fields: [actionId], references: [id], onDelete: Restrict)
  appellant   User         @relation("AppealAuthor", fields: [appellantId], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([appellantId, createdAt])
}

model UserSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}
